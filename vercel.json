{
  "crons": [
    {
      "path": "/api/cron/process-queue",
      "schedule": "*/1 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/admin/login",
      "destination": "/api/admin/login-page.html"
    },
    {
      "source": "/admin/dashboard.html",
      "destination": "/api/admin/dashboard.html"
    }
  ]
}
