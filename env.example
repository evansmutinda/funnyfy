# FunnyFy Environment Variables
# Copy this file to .env.local for local development
# DO NOT commit .env.local to git

# ============================================
# DATABASE (Required)
# ============================================
# PostgreSQL connection string from Supabase
# Format: postgresql://user:password@host:port/database
# URL-encode special characters in password (@ → %40, , → %2C, etc.)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# ============================================
# REPLICATE API (Required)
# ============================================
# Replicate API endpoint (usually doesn't change)
TARGET_API_URL=https://api.replicate.com/v1/predictions

# Your Replicate API token
# Get from: https://replicate.com/account/api-tokens
TARGET_API_KEY=r8_your_replicate_api_key_here

# Shared secret appended as ?token= on Replicate completion webhooks.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Also set PUBLIC_API_URL (or rely on ALLOWED_ORIGIN) so predictions can register the callback.
REPLICATE_WEBHOOK_SECRET=your_replicate_webhook_secret_here

# Public API base URL used for Replicate webhooks (no trailing slash).
# Staging: https://funnyfy-staging.vercel.app
# Production: https://funnyfyapp.vercel.app
# Falls back to ALLOWED_ORIGIN when that is an https URL.
PUBLIC_API_URL=https://funnyfy-staging.vercel.app

# ============================================
# CORS & SECURITY (Required)
# ============================================
# Allowed CORS origin
# Production: https://funnyfyapp.vercel.app
# Staging: https://funnyfy-staging.vercel.app
# Development: * (allows all - NOT for production)
ALLOWED_ORIGIN=https://funnyfyapp.vercel.app

# ============================================
# AUTHENTICATION (Optional, but recommended)
# ============================================
# JWT secret for token signing/verification
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_min_32_chars

# Alternative name (also supported)
# AUTH_SECRET=your_auth_secret_here

# ============================================
# RATE LIMITING (Optional)
# ============================================
# Maximum requests per IP per minute
# Default: 30
IP_RATE_LIMIT_PER_MINUTE=60

# ============================================
# QUEUE PROCESSING (Optional)
# ============================================
# Maximum concurrent jobs processed
# Default: 10
MAX_CONCURRENT_JOBS=10

# Secret for protecting /api/cron/* endpoints from public access.
# Configured in cron-job.org as the Authorization header:
#   Authorization: Bearer <CRON_SECRET>
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your_cron_secret_here

# ============================================
# REVENUECAT (Required when using subscriptions)
# ============================================
# Webhook secret from RevenueCat dashboard
# Get from: RevenueCat → Project Settings → Webhooks → Webhook Secret
REVENUECAT_WEBHOOK_SECRET=your_revenuecat_webhook_secret

# ============================================
# TELEGRAM (Optional — sticker pack bot)
# ============================================
# Bot token from @BotFather. Used to resolve the bot username for Telegram sticker sharing.
# TELEGRAM_BOT_TOKEN=123456:ABC...

# ============================================
# ADMIN DASHBOARD (Optional)
# ============================================
# Comma-separated list of user IDs that have admin access
# Leave empty to allow any authenticated user (for testing)
# Example: ADMIN_USER_IDS=user-id-1,user-id-2,user-id-3
ADMIN_USER_IDS=

# ============================================
# NODE ENVIRONMENT (Automatic)
# ============================================
# Set automatically by Vercel
# Development: NODE_ENV=development
# Production: NODE_ENV=production
# NODE_ENV=development
