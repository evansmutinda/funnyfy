{
  "cli": {
    "version": ">= 5.2.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "SENTRY_ORG": "funnyfy",
        "SENTRY_PROJECT": "react-native",
        "EXPO_PUBLIC_API_URL": "https://funnyfyapp.vercel.app",
        "EXPO_PUBLIC_SENTRY_ENV": "production"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "SENTRY_ORG": "funnyfy",
        "SENTRY_PROJECT": "react-native",
        "EXPO_PUBLIC_API_URL": "https://funnyfyapp.vercel.app",
        "EXPO_PUBLIC_SENTRY_ENV": "production"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
