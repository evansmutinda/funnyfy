# STAGING (for testing - use this first!)
EXPO_PUBLIC_API_URL=https://funnyfy-staging.vercel.app
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=test_kDONbOMshuIcMeJIywMnnVsYOxu
EXPO_PUBLIC_REVENUECAT_IOS_KEY=test_kDONbOMshuIcMeJIywMnnVsYOxu

# Sentry (React Native — not @sentry/react web SDK)
# Create project at sentry.io → platform: React Native
EXPO_PUBLIC_SENTRY_DSN=https://YOUR_KEY@oXXXX.ingest.us.sentry.io/PROJECT_ID
EXPO_PUBLIC_SENTRY_ENV=staging
# Set true to send events from debug/Metro builds (__DEV__)
EXPO_PUBLIC_SENTRY_ENABLED=true
# Optional one-time connection test on launch (rebuild after toggling):
# EXPO_PUBLIC_SENTRY_TEST=true

# PRODUCTION (uncomment when ready for production)
# EXPO_PUBLIC_API_URL=https://funnyfyapp.vercel.app
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=your_production_android_key
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=your_production_ios_key