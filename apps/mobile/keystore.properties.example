# Copy to keystore.properties (gitignored) after running scripts/generate-release-keystore.ps1
# Paths are relative to android/ (Gradle rootProject.file("../keystore.properties") from android/app).

storeFile=../android/app/funnyfy-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=funnyfy
keyPassword=YOUR_KEY_PASSWORD
